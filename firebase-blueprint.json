{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Apparel product in the Wicked catalog",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 120, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "slug": { "type": "string", "minLength": 2, "maxLength": 140, "pattern": "^[a-z0-9\\-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 140 },
        "category": { "type": "string", "enum": ["tees", "shirts", "kurtas", "hoodies", "bottoms", "accessories"] },
        "gender": { "type": "string", "enum": ["men", "women", "unisex"] },
        "fit": { "type": "string", "minLength": 2, "maxLength": 60 },
        "price": { "type": "number" },
        "compareAtPrice": { "type": "number" },
        "gsm": { "type": "number" },
        "fabric": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "isNew": { "type": "boolean" },
        "onSale": { "type": "boolean" },
        "featured": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "slug", "name", "category", "gender", "fit", "price", "description"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private customer profile storing contact info",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "maxLength": 120 },
        "email": { "type": "string", "format": "email", "maxLength": 180 },
        "phone": { "type": "string", "maxLength": 20 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "SavedAddress": {
      "title": "SavedAddress",
      "description": "Customer saved delivery address",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 120, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "label": { "type": "string", "maxLength": 40 },
        "fullName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "phone": { "type": "string", "minLength": 10, "maxLength": 15 },
        "line1": { "type": "string", "minLength": 4, "maxLength": 240 },
        "city": { "type": "string", "minLength": 2, "maxLength": 80 },
        "state": { "type": "string", "minLength": 2, "maxLength": 80 },
        "pincode": { "type": "string", "minLength": 6, "maxLength": 6, "pattern": "^[1-9][0-9]{5}$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "fullName", "phone", "line1", "city", "state", "pincode", "createdAt"]
    },
    "WishlistItem": {
      "title": "WishlistItem",
      "description": "Customer saved wishlist product reference",
      "type": "object",
      "properties": {
        "productId": { "type": "string", "minLength": 2, "maxLength": 120, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["productId", "userId", "createdAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order with payment and status tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "status": { "type": "string", "enum": ["placed", "paid", "packed", "shipped", "delivered", "cancelled", "returned"] },
        "paymentMethod": { "type": "string", "enum": ["razorpay", "cod"] },
        "total": { "type": "number" },
        "subtotal": { "type": "number" },
        "shippingFee": { "type": "number" },
        "discount": { "type": "number" },
        "trackingNumber": { "type": "string", "maxLength": 80 },
        "exchangeRequested": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "status", "paymentMethod", "total", "createdAt"]
    },
    "Review": {
      "title": "Review",
      "description": "Product review with optional verified buyer flag",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "productId": { "type": "string", "minLength": 2, "maxLength": 120, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorName": { "type": "string", "minLength": 2, "maxLength": 80 },
        "rating": { "type": "number" },
        "title": { "type": "string", "minLength": 2, "maxLength": 120 },
        "body": { "type": "string", "minLength": 4, "maxLength": 1000 },
        "verifiedBuyer": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "productId", "userId", "authorName", "rating", "title", "body", "createdAt"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Discount coupon configuration",
      "type": "object",
      "properties": {
        "code": { "type": "string", "minLength": 3, "maxLength": 32, "pattern": "^[A-Z0-9_\\-]+$" },
        "percentOff": { "type": "number" },
        "minSubtotal": { "type": "number" },
        "active": { "type": "boolean" }
      },
      "required": ["code", "percentOff", "active"]
    },
    "ShowcaseConfig": {
      "title": "ShowcaseConfig",
      "description": "Interactive showcase settings including 360 sequence and lookbook hotspots",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id"]
    },
    "BannerConfig": {
      "title": "BannerConfig",
      "description": "Homepage hero and marquee banner configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "headline": { "type": "string", "maxLength": 160 },
        "marqueeText": { "type": "string", "maxLength": 240 }
      },
      "required": ["id", "headline"]
    },
    "AdminMarker": {
      "title": "AdminMarker",
      "description": "Admin role assignment document keyed by admin UID",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 180 }
      },
      "required": ["uid", "email"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Public product catalog documents"
    },
    "/coupons/{couponId}": {
      "schema": { "$ref": "#/entities/Coupon" },
      "description": "Active discount coupons"
    },
    "/showcase/{docId}": {
      "schema": { "$ref": "#/entities/ShowcaseConfig" },
      "description": "Interactive showcase configuration documents"
    },
    "/banners/{bannerId}": {
      "schema": { "$ref": "#/entities/BannerConfig" },
      "description": "Storefront banner and marquee configuration"
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Customer product reviews"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private customer profile documents"
    },
    "/users/{userId}/addresses/{addressId}": {
      "schema": { "$ref": "#/entities/SavedAddress" },
      "description": "Customer saved delivery addresses"
    },
    "/users/{userId}/wishlist/{itemId}": {
      "schema": { "$ref": "#/entities/WishlistItem" },
      "description": "Customer wishlist items"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer order records"
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminMarker" },
      "description": "Admin role documents"
    }
  }
}
