# GEMINI_API_KEY: Required for Gemini AI API calls if used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# ALLOWED_ORIGINS: Comma-separated origins allowed for CORS (defaults to APP_URL + localhost).
ALLOWED_ORIGINS="http://localhost:3000"

# Razorpay Keys (Test Mode defaults: keep Key Secret and Webhook Secret strictly server-side!)
# Obtain test keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Admin Email (Bootstrapped store owner email)
ADMIN_EMAIL="harshuljain923@gmail.com"
